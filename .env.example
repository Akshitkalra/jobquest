# ==========================================
# Neon DB (PostgreSQL)
# ==========================================
NEON_DB_URL='postgresql://<db_user>:<db_password>@<your-neon-host>.neon.tech/neondb?sslmode=require'
NEON_DB_USER=your_db_user
NEON_DB_PASSWORD=your_db_password

# ==========================================
# JWT
# ==========================================
JWT_SECRET=your_jwt_secret_here

# ==========================================
# Cloudinary
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# ML Service
# ==========================================
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=your_ml_service_api_key

# ==========================================
# Pinecone
# ==========================================
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=jobportal
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ==========================================
# Next.js
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=JobPortal
